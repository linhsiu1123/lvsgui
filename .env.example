# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. `.env*` files are gitignored.
# ─────────────────────────────────────────────────────────────

# Auth.js (NextAuth) core
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=
# Public base URL of this app (used for OIDC redirect URIs).
AUTH_URL=http://localhost:3000

# Keycloak (OIDC provider)
# Issuer = <keycloak-host>/realms/<realm>
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/lvs
KEYCLOAK_CLIENT_ID=lvs-web
# Confidential clients only (Client authentication = On → Credentials tab).
# Leave EMPTY for a public client: it has no secret and signs in with PKCE.
KEYCLOAK_CLIENT_SECRET=
# Optional overrides:
KEYCLOAK_SCOPES=openid profile email
# Refresh the access token this many seconds before it expires.
OIDC_REFRESH_THRESHOLD=60

# Backend service (proxied by the Next.js API routes, with the OIDC token attached)
BACKEND_BASE_URL=https://api.example.com
BACKEND_TIMEOUT_MS=15000

# ─── DEBUG: run without a backend ─────────────────────────────
# Set to "true" to serve every /api/* route from an in-memory mock
# (lib/mock/backend.ts) instead of BACKEND_BASE_URL — approve/reject, routing
# flows, and skills all work against seeded fixtures, no backend or MongoDB
# needed. Independent of AUTH_BYPASS below: middleware.ts still enforces
# Keycloak unless that is also set. IGNORED in a production build.
USE_MOCK_DATA=false

# ─── DEBUG: run without Keycloak ──────────────────────────────
# Set to "true" to skip authentication entirely: every request is let through
# with a stub identity and no sign-in round-trip. Use only for local UI work.
# IGNORED in a production build — the app keeps enforcing Keycloak there.
# With this on you need none of the KEYCLOAK_* vars, and not even AUTH_SECRET.
AUTH_BYPASS=false
# Optional stub identity shown for the bypassed operator.
AUTH_BYPASS_USER=Debug User
AUTH_BYPASS_EMAIL=debug@localhost
# Optional bearer token to still send to the backend while bypassing Keycloak.
# Leave empty to call the backend with no Authorization header (local mocks).
AUTH_BYPASS_TOKEN=

# In Keycloak, set the client's valid redirect URI to:
#   {AUTH_URL}/api/auth/callback/keycloak
# For a public client also set Web origins to {AUTH_URL} and, under Advanced,
# "Proof Key for Code Exchange Code Challenge Method" to S256.
