# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. `.env*` files are gitignored.
# ─────────────────────────────────────────────────────────────

# Auth.js (NextAuth) core
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET=
# Public base URL of this app (used for OIDC redirect URIs).
AUTH_URL=http://localhost:3000

# Keycloak (OIDC provider)
# Issuer = <keycloak-host>/realms/<realm>
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/lvs
KEYCLOAK_CLIENT_ID=lvs-web
# Confidential clients only (Client authentication = On → Credentials tab).
# Leave EMPTY for a public client: it has no secret and signs in with PKCE.
KEYCLOAK_CLIENT_SECRET=
# Optional overrides:
KEYCLOAK_SCOPES=openid profile email
# Refresh the access token this many seconds before it expires.
OIDC_REFRESH_THRESHOLD=60

# Backend service (proxied by the Next.js API routes, with the OIDC token attached)
BACKEND_BASE_URL=https://api.example.com
BACKEND_TIMEOUT_MS=15000

# In Keycloak, set the client's valid redirect URI to:
#   {AUTH_URL}/api/auth/callback/keycloak
# For a public client also set Web origins to {AUTH_URL} and, under Advanced,
# "Proof Key for Code Exchange Code Challenge Method" to S256.
