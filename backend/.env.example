# Copy to `backend/.env` and adjust. `.env` is gitignored.

# --- MongoDB -------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=lvsqc
# Insert the demo fixtures when the collections are empty.
SEED_ON_STARTUP=true
# Days to keep activity-feed entries. 0 keeps them forever. A positive value
# installs a TTL index, so MongoDB starts EXPIRING (deleting) older entries.
ACTIVITY_RETENTION_DAYS=0

# --- Keycloak (OIDC) -----------------------------------------
# Must be the same realm the Next.js app signs in against.
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/lvs
# The frontend's client id; Keycloak stamps it into the token's `azp`.
KEYCLOAK_CLIENT_ID=lvs-web
# Expected `aud`. Keycloak usually issues `account` rather than the client id,
# so leave this EMPTY unless you added a dedicated audience mapper. When empty,
# `azp` is checked against KEYCLOAK_CLIENT_ID instead.
KEYCLOAK_AUDIENCE=
JWT_LEEWAY_SECONDS=30

# --- Development escape hatch --------------------------------
# Mirrors AUTH_BYPASS in the Next.js app: skip token validation entirely.
# IGNORED when ENVIRONMENT=production.
AUTH_BYPASS=false
ENVIRONMENT=development

# --- CORS ----------------------------------------------------
# Only needed when a browser calls this API directly. The Next.js proxy is
# server-side and needs none of these. JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]
